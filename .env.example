# 管理員後台需要的環境變數
# 在 Vercel 專案設定 → Settings → Environment Variables 裡新增這兩個，
# 不要把真正的值寫進這個檔案或提交進 git。

# 管理員登入密碼，自己決定一組夠長、夠複雜的密碼
ADMIN_PASSWORD=

# 用來簽章登入 session cookie 的隨機字串，建議 32 個字元以上的亂數字串
# 可以在終端機執行以下指令產生一組：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
